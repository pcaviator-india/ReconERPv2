const MOVEMENTS_SHEET = "Inv_Movement"; 
const STATUS_SHEET = "ItemStatus";
const HSE_SIGN_SHEET = "HSE_Signatures";
const PEOPLE_SHEET = "People";

function bulkIssueItems(payload) {

  const ss = SpreadsheetApp.getActiveSpreadsheet(); 
  const mov = ss.getSheetByName(MOVEMENTS_SHEET); 

  const ts = new Date(); 
  const movementId = generateMovementId(); 

  const itemCondition = payload.condition || "Consumable";

  payload.items.forEach(item => {

    mov.appendRow([
      movementId, 
      ts, 
      item.geo, 
      "ISSUE",  
      item.qty, 
      payload.person,  
      payload.sector || "",  
      payload.maquina || "", 
      payload.generador || "",  
      payload.vehiculo || "", 
      itemCondition,        
      payload.comments || "",  
      "" 
    ]);

    updateStatus(
      item.geo, 
      "IN_USE", 
      payload.person, 
      payload.sector, 
      ts,
      itemCondition 
    );

  });
  console.log("Bulk issue : ", payload.isHSE);

  if (payload.isHSE && payload.hseItems && payload.hseItems.length > 0) {
    console.log("Starting bulk payload for HSE items");

    console.log("Fingerprint Type: " + typeof payload.fingerprintBase64);
    console.log("Fingerprint Length: " + (payload.fingerprintBase64 ? payload.fingerprintBase64.length : "NULL"));

    if (payload.fingerprintBase64) {
      console.log("Starts with data prefix: " + payload.fingerprintBase64.substring(0, 30));
    }

   try {
          const hseSheet = getOrCreateHSESignaturesSheet();
          
          const person = getPersonById(payload.personId);
          const workerRut = person ? person.rut : "N/A";
          const workerName = person ? person.name : (payload.person || "UNKNOWN");

          const pdfData = {
            movementId: movementId,
            timestamp: ts,
            workerName: workerName,
            workerRut: workerRut, 
            fingerprintBase64: payload.fingerprintBase64 || "",
            matchScore: payload.matchScore || 0,
            hseItems: payload.hseItems
          };

          const pdfBlob = generateHSEReceiptPDF(pdfData);
          
          const driveLink = saveHSEPDFToDrive(movementId, workerRut, workerName, pdfBlob);

          hseSheet.appendRow([
            movementId,
            workerRut,    
            workerName,
            payload.fingerprintBase64 || "",
            payload.matchScore || 0,
            ts,
            payload.hseItems.length,
            driveLink
          ]);

          console.log("HSE PDF generated for RUT: " + workerRut);
        } catch (e) {
          console.error("HSE Processing Error: " + e.toString());
        }
  }
  const stockResult = processInventoryMovement({
    ...payload,
    movementId: movementId,
    userName: payload.person || "System"   
  }, "ISSUE");

  return {
    success: true,
    message: "Bulk issue completed" 
  };
}

function bulkReturnItems(payload) {

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const mov = ss.getSheetByName(MOVEMENTS_SHEET);

  const ts = new Date();
  const movementId = generateMovementId();

  payload.items.forEach(item => {

    mov.appendRow([
      movementId,
      ts,
      item.geo,
      "RETURN",
      item.qty,
      payload.person,
      payload.sector || "",
      payload.maquina || "",
      payload.generador || "",
      payload.vehiculo || "",
      "Good",
      payload.comments || "",
      ""
    ]);

    updateStatus(
      item.geo,
      "IN_STORE",
      "",
      "STORE",
      ts,
      "Good"
    );

  });

  const stockResult = processInventoryMovement({
    ...payload,
    movementId: movementId,
    userName: payload.person || "System"
  }, "RETURN");

  
  return {
    success: true,
    message: "Bulk return completed"
  };
}


function getOrCreateHSESignaturesSheet() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sheet = ss.getSheetByName(HSE_SIGN_SHEET);

  if (!sheet) {
    sheet = ss.insertSheet(HSE_SIGN_SHEET);
    sheet.appendRow([
      "MovementID",
      "WorkerID",
      "WorkerName",
      "FingerprintBase64",
      "MatchScore",
      "MatchTimestamp",
      "ItemsCount",
      "PDFDriveLink"
    ]);
  }

  return sheet;
}

function getPersonById(personId) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName(PEOPLE_SHEET);

  if (!sheet) return null;

  const data = sheet.getDataRange().getValues();

  for (let i = 1; i < data.length; i++) {
    if (String(data[i][0]) === String(personId) || String(data[i][1]) === String(personId)) {
      return {
        id: data[i][0],
        name: data[i][1],
        department: data[i][2],
        active: data[i][3],
        sector: data[i][4],
        rut: data[i][6],
        biometricTemplate: data[i][7] || ""
      };
    }
  }

  return null;
}

