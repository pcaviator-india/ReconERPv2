  function processInventoryMovement(payload, action) {
  if (!payload || !payload.items || payload.items.length === 0) {
    return { success: false, message: "No items" };
  }

  const userName = payload.userName || "System";
  
  // 1. Target Destination Location (Selected Sector Dropdown)
  const targetSector = payload.sector || "Unknown"; 
  
  // 2. Sourced Location (From the logged-in user's site)
  const userSite = payload.userSite; 

  // Strict Protection Safeguard
  if (!userSite || userSite.trim() === "") {
    throw new Error("CRITICAL: Inventory movement canceled. The user's active operating site is undefined.");
  }

  const movementId = payload.movementId || "MOV-" + new Date().getTime();
  let results = [];

  payload.items.forEach(item => {
    const itemId = item.geo || item.barcode;

    if (action === "ISSUE") {
      // Deduct quantity from User Site (Location A)
      const deduct = updateStock(
        itemId,
        "Location",
        userSite,          // <--- Location A (Deduction)
        -item.qty,
        "InternalMove",
        movementId,
        "InvMov",
        `Issued from ${userSite} to ${targetSector} (Person: ${payload.person || 'Person'})`,
        userName,
        targetSector
      );
      results.push(deduct);

      // Add quantity to Target Sector (Location B)
      const add = updateStock(
        itemId,
        "Location",
        targetSector,      // <--- Location B (Addition)
        item.qty,
        "InternalMove",
        movementId,
        "InvMov",
        `Received at ${targetSector} from ${userSite}`,
        userName,
        targetSector
      );
      results.push(add);
    } 
    else if (action === "RETURN") {
      // Deduct quantity from Target Sector (Location B)
      const deduct = updateStock(
        itemId,
        "Location",
        targetSector,      // <--- Location B (Deduction)
        -item.qty,
        "InternalMove",
        movementId,
        "InvMov",
        `Returned from ${targetSector} to ${userSite} (Person: ${payload.person || 'Person'})`,
        userName,
        targetSector
      );
      results.push(deduct);

      // Add quantity back to User Site (Location A)
      const add = updateStock(
        itemId,
        "Location",
        userSite,          // <--- Location A (Addition)
        item.qty,
        "InternalMove",
        movementId,
        "InvMov",
        `Restocked at ${userSite} from ${targetSector}`,
        userName,
        targetSector
      );
      results.push(add);
    }
  });

  console.log(`Processed ${action} movement with ${results.length} double-entry steps`);
  return { success: true, processed: results.length };
}